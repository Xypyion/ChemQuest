# StoiVenture — environment
#
# Copy this file to `.env` (which is git-ignored) and fill in what you need.
# A real environment variable always wins over anything in `.env`.
# NEVER commit `.env`. Nothing in THIS file may be a real secret.

# ---- the teacher account ----------------------------------------------
# Used by `npm run seed` when it creates the very first teacher on an empty
# database. Leave TEACHER_PASSWORD blank and the seed generates a strong one
# and prints it once — that is safer than any value written down here.
#
# To set or change the account later, run:  npm run teacher
# It asks in the terminal and never echoes the password.
TEACHER_NAME=Teacher
TEACHER_EMAIL=
TEACHER_PASSWORD=

# ---- the AI tutor -------------------------------------------------------
# A Google AI Studio key. Without it the tutor is simply disabled; the rest of
# StoiVenture works normally.
GEMINI_API_KEY=

# ---- server -------------------------------------------------------------
# Port 4000, never 3000 — 3000 is permanently taken on the school machine.
PORT=4000

# Sign your own tokens in production. Unset falls back to a dev default, which
# means anyone who knows it can mint a session.
JWT_SECRET=

# Unset  = JSON file store at data/db.json
# Set    = Postgres, and REQUIRED on serverless hosts (read-only filesystem)
DATABASE_URL=
