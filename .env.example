# StoiVenture — environment
#
# Copy this file to `.env` (which is git-ignored) and fill in what you need.
# A real environment variable always wins over anything in `.env`.
# NEVER commit `.env`. Nothing in THIS file may be a real secret.

# ---- the teacher account ----------------------------------------------
# Used by `npm run seed` when it creates the very first teacher on an empty
# database. Leave these blank and it uses the default in src/seed.js
# (krucj@gmail.com / StoiVenture2026), which is in a public repo and therefore
# public. Set them here to seed a fresh database with your own instead.
#
# To change the account on a database that already exists, run:  npm run teacher
# It asks in the terminal and never echoes the password.
TEACHER_NAME=
TEACHER_EMAIL=
TEACHER_PASSWORD=

# ---- the AI features ----------------------------------------------------
# A Google AI Studio key. It powers three things: Kru CJ the challenge tutor,
# "write these questions for me" in the teacher console, and the check that
# stands between a student-written duel question and their classmates.
# Without it all three are disabled and the rest of StoiVenture works normally.
GEMINI_API_KEY=

# Which model those three use. Leave blank for the built-in default,
# gemini-3.1-flash-lite — cheap enough for a free tier and still gets the
# arithmetic in an answer key right. One name for all three, so moving to a
# bigger model is a single edit here.
#
# A model that does not accept a `thinking_level` is handled: the first call
# notices the refusal, says so in the log, and every call after it goes without.
GEMINI_MODEL=

# How many AI calls one person may make per day. A guard rail for a free API
# tier, not a game rule — the tutor's own coin price is separate (src/tutorCredit.js).
# 0 means unlimited.
AI_GENERATE_LIMIT=60
AI_REVIEW_LIMIT=20

# ---- server -------------------------------------------------------------
# Port 4000, never 3000 — 3000 is permanently taken on the school machine.
PORT=4000

# Sign your own tokens in production. Unset falls back to a dev default, which
# means anyone who knows it can mint a session.
JWT_SECRET=

# Unset  = JSON file store at data/db.json
# Set    = Postgres, and REQUIRED on serverless hosts (read-only filesystem)
DATABASE_URL=
